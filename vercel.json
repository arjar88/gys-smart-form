{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/subform", "destination": "/submission", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|@.*|__.*|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}